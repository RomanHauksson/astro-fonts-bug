---
import { Font } from "astro:assets";
import { createFontStack } from "@capsizecss/core";
import notoSans from "@capsizecss/metrics/notoSans";
import arial from "@capsizecss/metrics/arial";
const capsizeFontStack = createFontStack([notoSans, arial]);
const capsizeFontFaces = capsizeFontStack.fontFaces;
const capsizeFontFamily = capsizeFontStack.fontFamily;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro</title>

    <Font cssVariable="--astro-noto-sans" preload />
    <style set:html={capsizeFontFaces}></style>

    <!-- These are the font faces that Astro and Capsize each generate, copied from dist/index.html. I renamed font-family to avoid conflicts. -->
    <style>
      @font-face {
        font-family: "Astro fallback";
        src: local("Arial");
        font-display: swap;
        font-weight: 400;
        font-style: normal;
        size-adjust: 122.9249%;
        ascent-override: 86.9637%;
        descent-override: 23.8357%;
        line-gap-override: 0%;
      }

      @font-face {
        font-family: "Capsize fallback";
        src: local("Arial"), local("ArialMT");
        ascent-override: 100.5403%;
        descent-override: 27.5569%;
        line-gap-override: 0%;
        size-adjust: 106.3255%;
      }
    </style>
  </head>
  <body>
    <div>
      <h1>Demo</h1>
      <p>
        The first paragraph uses the font family generated by Astro's fonts API,
        and the second uses the one generated by Capsize. For both of them,
        font-display is set to swap.
      </p>
      <p style="font-family: var(--astro-noto-sans);">
        The quick brown fox jumps over the lazy dog
      </p>
      <p style=`font-family: ${capsizeFontFamily};`>
        The quick brown fox jumps over the lazy dog
      </p>
    </div>
    <div>
      <h1>Diffs</h1>
      <h2>Astro's diff</h2>
      <div style="position: relative;">
        <p style="font-family: var(--astro-noto-sans);">
          The quick brown fox jumps over the lazy dog
        </p>
        <p
          style="font-family: 'Astro fallback'; position: absolute; top: 0; left: 0; margin-top: 0; color: blue;"
        >
          The quick brown fox jumps over the lazy dog
        </p>
      </div>
      <h2>Capsize's diff</h2>
      <div style="position: relative;">
        <p style="font-family: var(--astro-noto-sans);">
          The quick brown fox jumps over the lazy dog
        </p>
        <p
          style="font-family: 'Capsize fallback'; position: absolute; top: 0; left: 0; margin-top: 0; color: blue;"
        >
          The quick brown fox jumps over the lazy dog
        </p>
      </div>
    </div>
  </body>
</html>
